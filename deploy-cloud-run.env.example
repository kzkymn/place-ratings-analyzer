# Copy this file to deploy-cloud-run.env (gitignored) in the same directory
# (repo root) and fill in real values. tools/deploy-cloud-run.sh sources it
# automatically if present, or you can export these same variables directly
# instead.

# GCP project to deploy into
PROJECT_ID="your-gcp-project-id"

# Cloud Run region
REGION="asia-northeast1"

# Cloud Run service name (also used as the Artifact Registry image name)
SERVICE_NAME="place-ratings-analyzer"

# Secret Manager secret name holding the Google OAuth client secret
# (create it first: gcloud secrets create "$SECRET_NAME" --data-file=-)
SECRET_NAME="mcp-client-secret"

# Firestore database name used for OAuth session storage
# (create it first: gcloud firestore databases create --database="$FIRESTORE_DATABASE" --location="$REGION")
FIRESTORE_DATABASE="oauth-sessions"

# Google OAuth client ID (not secret - safe to commit, but kept here for convenience)
MCP_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# This service's own public URL once deployed (see the "Precompute the URL"
# step in SKILL.md for how to know this before the first deploy)
MCP_BASE_URL="https://your-service-name-your-project-number.your-region.run.app"
