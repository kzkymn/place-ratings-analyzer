# Google Maps MCP Server - Environment Variables Configuration
#
# This file contains example environment variable configurations for the MCP server.
# Copy this file to .env and fill in your actual values.
#
# Note: .env file should be added to .gitignore to avoid committing sensitive information.

# ============================================================================
# Google OAuth Authentication Configuration (HTTP mode only)
# ============================================================================
# These settings are only used when running the server in HTTP mode.
# For stdio mode (Claude Desktop integration), authentication is not required.

# Google OAuth Client ID (required for OAuth authentication)
# Get from: https://console.cloud.google.com/auth/clients
# MCP_CLIENT_ID=123456789.apps.googleusercontent.com

# Google OAuth Client Secret (required for OAuth authentication)
# MCP_CLIENT_SECRET=GOCSPX-your-secret-here

# Base URL of your HTTP server (required for OAuth callback)
# Development: http://localhost:8888
# Production: https://your-domain.com
# MCP_BASE_URL=http://localhost:8888

# ============================================================================
# Google Cloud Console Setup Instructions
# ============================================================================
#
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing one
# 3. Navigate to "Google Auth Platform" → "Clients"
# 4. Click "+ CREATE CLIENT"
# 5. Application type: Web application
# 6. Authorized redirect URIs: Add {MCP_BASE_URL}/auth/callback
#    Example: http://localhost:8888/auth/callback
# 7. Copy the Client ID and Client Secret to this file
#
# ============================================================================
# Usage Examples
# ============================================================================
#
# 1. No Authentication (Local Development):
#    Simply leave all OAuth variables commented out
#
# 2. Google OAuth Enabled:
#    MCP_CLIENT_ID=123456789.apps.googleusercontent.com
#    MCP_CLIENT_SECRET=GOCSPX-your-secret-here
#    MCP_BASE_URL=http://localhost:8888
#
# ============================================================================
# Server Startup Commands
# ============================================================================
#
# stdio mode (for Claude Desktop; registered in claude_desktop_config.json):
#   docker run -i --rm --shm-size=1g place-ratings-analyzer:latest python -m src.server
#
# HTTP mode:
#   docker compose up --build                      # no auth
#   docker compose -f docker-compose.yml -f docker-compose.auth.yml up --build  # with OAuth (.env)
#
# (python -m src.server is the entry point inside the container; for local
#  development usage see .agents/skills/mcp-server/)
