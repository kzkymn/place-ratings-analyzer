# Version pins — single source of truth
# (consumers: Dockerfile, src/playwright_driver.py)
#
# GMS_REF: vendored google-maps-scraper release tag
# GO_VERSION: Go toolchain required by the scraper's go.mod at GMS_REF
# PW_CLI_VERSION: playwright-core driver version — must equal the playwrightCliVersion
#   constant of the playwright-go release the scraper pins at GMS_REF
#   (v1.12.1 → playwright-go v0.5700.1 → 1.57.0)
GMS_REF=v1.12.1
GO_VERSION=1.26.2
PW_CLI_VERSION=1.57.0
