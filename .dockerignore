# Build context exclusions

# VCS / 開発環境
.git/
.gitignore
.venv/
.go/
.serena/
.claude/
.agents/

# scraper は Dockerfile 内で upstream から clone するため、ローカルの作業ツリーは送らない
google-maps-scraper/

# Python 生成物
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
.coverage.*

# テスト・ドキュメント・作業ファイル（実行イメージには不要）
test/
doc/
_tmp/
.private/
*.log
*.tar.gz

# 秘密情報混入防止（現状DockerfileはCOPY . .ではなくversions.env/requirements.txt/
# config.json/src//data/のように必要なファイルだけを名指しでコピーしており実害はないが、
# 将来COPY . .等の広いコピーに変わった場合の防御線として維持する）
.env
