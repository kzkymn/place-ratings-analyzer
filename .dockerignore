# Build context exclusions

# VCS / 開発環境
.git/
.gitignore
.venv/
.go/
.serena/
.claude/
.agents/

# scraper は Dockerfile 内で upstream から clone するため、ローカルの作業ツリーは送らない
google-maps-scraper/

# Python 生成物
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
.coverage.*

# テスト・ドキュメント・作業ファイル（実行イメージには不要）
test/
doc/
_tmp/
.private/
*.log
*.tar.gz
