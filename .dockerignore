# Build context exclusions
#
# 注意: .env をイメージに含めない。含めると src/server.py の load_dotenv() が
# それを読んでしまい、「認証はデフォルトOFF」という前提が崩れる。
# OAuth を使う場合は docker-compose.auth.yml が実行時に .env を注入する。
.env

# VCS / 開発環境
.git/
.gitignore
.venv/
.go/
.serena/
.claude/
.agents/

# scraper は Dockerfile 内で upstream から clone するため、ローカルの作業ツリーは送らない
google-maps-scraper/

# Python 生成物
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
.coverage.*

# テスト・ドキュメント・作業ファイル（実行イメージには不要）
test/
doc/
_tmp/
.private/
*.log
*.tar.gz
